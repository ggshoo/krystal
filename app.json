{
  "expo": {
    "name": "crystal",
    "slug": "crystal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "crystal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gigihsu.crystal"
    },
    "android": {
      "package": "com.gigihsu.crystal"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
