{
  "expo": {
    "name": "crystal",
    "slug": "crystal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "crystal",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gigihsu.crystal",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gigihsu.crystal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF3E2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF3E2",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#221B2E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E97451"
        }
      ],
      "expo-localization"
    ]
  }
}
