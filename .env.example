# Supabase — get these from your project's API settings
# https://supabase.com/dashboard → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog — for the PM-portfolio metrics (north star + 4 input metrics).
# Get the key at https://app.posthog.com/settings/project → "Project API Key".
# If left blank, analytics is silently disabled (dev builds keep working).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
